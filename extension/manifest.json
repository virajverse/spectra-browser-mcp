{
  "manifest_version": 3,
  "name": "SpectraBrowser MCP Bridge",
  "version": "1.0.0",
  "description": "Connects your live Chrome tabs and logged-in profiles directly to SpectraBrowser MCP without restarts or debug flags.",
  "permissions": [
    "debugger",
    "tabs",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpectraBrowser MCP Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
